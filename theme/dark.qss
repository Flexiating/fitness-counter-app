/* Shared dark design system, all dimensions are device-independent. */
QMainWindow, QDialog, QScrollArea { background:#0F1115; color:#F5F7FA; }
QWidget#settingsPage, QFrame#guidePage { background:#0F1115; }
QWidget { font-family:"Arial"; font-size:14px; color:#F5F7FA; }
QFrame#headerCard { background:transparent; border-bottom:1px solid #292E39; }
QFrame#sidebarCard, QFrame#card, QFrame#miniCard, QFrame#statCard, QFrame#guideCard, QFrame#compactStatus { background:#171A21; border:1px solid #292E39; border-radius:16px; }
QFrame#miniCard:hover, QFrame#statCard:hover, QFrame#guideCard:hover { border-color:#36587D; }
QLabel { background:transparent; border:none; }
QLabel#appTitle { font-size:23px; font-weight:700; letter-spacing:-0.5px; }
QLabel#exerciseTitle { color:#2D8CFF; font-size:14px; }
QLabel#sectionLabel { color:#A9B4C4; font-size:12px; font-weight:600; }
QLabel#headerValue { font-size:14px; font-weight:600; }
QLabel#muted { color:#A9B4C4; font-size:12px; }
QLabel#scoreValue { font-size:30px; font-weight:700; }
QLabel#statValue { font-size:22px; font-weight:600; }
QLabel#coachMessage { font-size:17px; font-weight:500; }
QLabel#placeholderTitle, QLabel#dialogTitle { font-size:28px; font-weight:700; }
QLabel#summaryValue { font-size:24px; font-weight:600; }
QLabel#cameraSurface { background:#000; color:#A9B4C4; border:1px solid #292E39; border-radius:18px; font-size:18px; }
QLabel#cameraHud, QLabel#cameraTimer { background:rgba(15,17,21,210); color:#F5F7FA; border:1px solid rgba(255,255,255,30); border-radius:12px; padding:10px; font-size:13px; }
QLabel#cameraTimer { font-size:18px; font-weight:600; }
QLabel#cameraCountdown { background:rgba(0,0,0,170); color:#fff; font-size:84px; font-weight:700; }
QLabel#guideText { color:#CFD6E1; font-size:15px; }
QPushButton { background:#232832; border:1px solid #343C4A; border-radius:12px; padding:6px 14px; font-size:13px; font-weight:600; }
QPushButton:hover { background:#2C3543; border-color:#52749D; }
QPushButton:pressed { background:#1A2940; }
QPushButton:focus { border:2px solid #72B4FF; }
QPushButton#primaryButton { background:#2D8CFF; color:#081A30; border-color:#2D8CFF; }
QPushButton#primaryButton:hover { background:#68ACFF; }
QPushButton:disabled { color:#748096; background:#1A1E26; border-color:#292E39; }
QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit { min-height:34px; background:#101319; border:1px solid #343C4A; border-radius:10px; padding:6px 10px; selection-background-color:#2D8CFF; }
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover { border-color:#52749D; }
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus { border:2px solid #72B4FF; }
QComboBox QAbstractItemView { background:#171A21; selection-background-color:#23446C; padding:8px; }
QCheckBox { spacing:10px; min-height:32px; color:#CFD6E1; }
QCheckBox::indicator { width:32px; height:18px; border-radius:9px; background:#343C4A; border:2px solid #6D7C93; }
QCheckBox::indicator:checked { background:#2D8CFF; border-color:#9AC8FF; }
QCheckBox::indicator:focus { border-color:#fff; }
QTabWidget#mainTabs::pane { border:none; }
QTabBar::tab { background:transparent; color:#A9B4C4; min-height:18px; padding:15px 30px; border:none; font-weight:600; }
QTabBar::tab:selected { color:#72B4FF; }
QTabBar::tab:hover { background:#171A21; color:#F5F7FA; }
QProgressBar { min-height:8px; max-height:8px; background:#292E39; border:none; border-radius:4px; }
QProgressBar::chunk { background:#2D8CFF; border-radius:4px; }
QTableWidget { background:#0F1115; border:none; gridline-color:transparent; selection-background-color:#1A304C; }
QHeaderView::section { background:#0F1115; color:#A9B4C4; padding:12px; border:none; }
QTableWidget::item { background:#171A21; padding:16px; border-bottom:8px solid #0F1115; }
QTableWidget::item:selected { background:#1A304C; color:#fff; }
QScrollBar:vertical { width:8px; background:transparent; margin:4px 0; }
QScrollBar::handle:vertical { background:#343C4A; border-radius:4px; min-height:28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height:0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background:transparent; }
QToolTip { background:#232832; color:#fff; border:1px solid #52749D; padding:8px; }
